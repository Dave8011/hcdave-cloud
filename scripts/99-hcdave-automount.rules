# /etc/udev/rules.d/99-hcdave-automount.rules
# Trigger automount script for new block devices

# Skip non-filesystem devices, loops, ramdisks, cdroms, etc.
ENV{ID_FS_USAGE}!="filesystem", GOTO="hcdave_automount_end"
KERNEL=="loop*|ram*|sr*|fd*", GOTO="hcdave_automount_end"

# Pass DEVNAME, UUID, and LABEL to the automount script
ACTION=="add", SUBSYSTEM=="block", RUN+="/usr/local/bin/hcdave-automount.sh add %k $env{ID_FS_UUID} $env{ID_FS_LABEL}"
ACTION=="remove", SUBSYSTEM=="block", RUN+="/usr/local/bin/hcdave-automount.sh remove %k"

LABEL="hcdave_automount_end"
