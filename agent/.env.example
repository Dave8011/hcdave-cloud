# HC Dave Cloud — Storage Agent Configuration
# Copy this file to .env and fill in your values
# chmod 600 .env

# ── Security ──────────────────────────────────────────────────
# Your login password for the web drive — use a strong password!
AUTH_PASSWORD=ChangeMe@2024

# ── Network ───────────────────────────────────────────────────
# Port the agent listens on (Cloudflare Tunnel points to this)
PORT=3001

# ── CORS ──────────────────────────────────────────────────────
# Only allow requests from your Vercel domain
ALLOWED_ORIGIN=https://drive.hcdavecloud.in
