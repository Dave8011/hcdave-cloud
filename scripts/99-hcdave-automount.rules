# /etc/udev/rules.d/99-hcdave-automount.rules
# Trigger automount script for new block devices via systemd

# Skip non-filesystem devices, loops, ramdisks, cdroms, etc.
ENV{ID_FS_USAGE}!="filesystem", GOTO="hcdave_automount_end"
KERNEL=="loop*|ram*|sr*|fd*", GOTO="hcdave_automount_end"

# Delegate mounting to a systemd service to avoid udev RUN restrictions
ACTION=="add", SUBSYSTEM=="block", TAG+="systemd", ENV{SYSTEMD_WANTS}+="hcdave-automount@%k.service"

LABEL="hcdave_automount_end"
